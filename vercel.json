{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/booking_schedule-fe/browser",
  "rewrites": [
    {
      "source": "/booking-schedule/:path*",
      "destination": "https://booking-schedule-be.onrender.com/booking-schedule/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
